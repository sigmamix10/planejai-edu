# EditorConfig is awesome: https://EditorConfig.org

# top-most EditorConfig file
root = true

# Unix-style newlines with a newline ending every file
[*]
end_of_line = lf
insert_final_newline = true
charset = utf-8

# 2 spaces for all JS, TS, JSX, TSX files
[*.{js,jsx,ts,tsx,json}]
indent_style = space
indent_size = 2

# 2 spaces for CSS/SCSS
[*.{css,scss}]
indent_style = space
indent_size = 2

# 2 spaces for HTML
[*.html]
indent_style = space
indent_size = 2

# YAML files with 2 spaces
[*.{yml,yaml}]
indent_style = space
indent_size = 2

# Markdown
[*.md]
trim_trailing_whitespace = false
